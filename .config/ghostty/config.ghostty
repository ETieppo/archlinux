confirm-close-surface             = false
window-inherit-working-directory  = true
gtk-single-instance               = false
shell-integration-features        = ssh-terminfo,ssh-env

macos-titlebar-style              = hidden
adjust-cell-height                = 10%
font-size                         = 12
font-family                       = "IosevkaCustom Nerd Font Extended"

palette                           = 1=#e41951
palette                           = 2=#01dc84
palette                           = 3=#faf945
palette                           = 9=#ff0051
palette                           = 10=#60fa68
palette                           = 11=#fffc67
background                        = #08080b
# background                        = #101116
foreground                        = #686868
# foreground                      = #e41951
cursor-color                      = #00FF00
cursor-text                       = #000000
selection-background              = #171827
selection-foreground              = #a500ff

keybind                           = alt+n=new_window
keybind                           = alt+shift+,=reload_config
