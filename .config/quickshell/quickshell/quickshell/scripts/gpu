#!/usr/bin/env bash

readonly NVIDIA_VENDOR=0x10de
readonly NVIDIA_FIELDS=utilization.gpu,utilization.memory,utilization.encoder,utilization.decoder,memory.used,memory.total,temperature.gpu,power.draw,clocks.gr,pstate,name

probe_igpu() {
    local card
    for card in /sys/class/drm/card*; do
        [[ -r $card/gt_act_freq_mhz ]] || continue
        echo "igpu $(<"$card/gt_act_freq_mhz") $(<"$card/gt_RP0_freq_mhz")"
        return
    done
}

probe_dgpu() {
    local dev status
    for dev in /sys/bus/pci/devices/*; do
        [[ $(<"$dev/vendor") == "$NVIDIA_VENDOR" && $(<"$dev/class") == 0x03* ]] || continue
        status=$(<"$dev/power/runtime_status")
        echo "dgpu $status"
        [[ $status == suspended ]] && return
        command -v nvidia-smi > /dev/null || return
        timeout 3 nvidia-smi --query-gpu="$NVIDIA_FIELDS" --format=csv,noheader,nounits | sed 's/^/nvidia /'
        return
    done
}

main() {
    probe_igpu
    probe_dgpu
}

main "$@"
